# Shared zsh config, sourced from ~/.zshrc (setup.sh adds the source line).
# Machine-specific settings stay in ~/.zshrc.

export PATH="/opt/homebrew/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"

alias d='docker'
alias dc='docker compose'
alias g='git'
alias lg='lazygit'

# claude code: layer this machine's extra settings on top of ~/.claude/settings.json.
# Work machines keep ~/.claude/settings.work.json, personal ones settings.personal.json
# (neither is in dotfiles). Work wins if both exist; with neither, plain claude runs.
claude() {
  local f
  for f in "$HOME/.claude/settings.work.json" "$HOME/.claude/settings.personal.json"; do
    if [ -f "$f" ]; then
      command claude --settings "$f" "$@"
      return
    fi
  done
  command claude "$@"
}
